<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KiDas" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0A0F1E</item>
        <item name="android:navigationBarColor">#0A0F1E</item>
        <item name="android:windowBackground">#0A0F1E</item>
    </style>
    <style name="Theme.KiDas.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0F1E</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.KiDas</item>
    </style>
</resources>
